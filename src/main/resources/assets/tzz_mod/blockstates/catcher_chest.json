{
  "multipart": [
    {
      "when": { "half": "lower", "open": "false", "facing": "north" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_closed", "y": 270 }
    },
    {
      "when": { "half": "lower", "open": "false", "facing": "east" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_closed", "y": 0 }
    },
    {
      "when": { "half": "lower", "open": "false", "facing": "south" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_closed", "y": 90 }
    },
    {
      "when": { "half": "lower", "open": "false", "facing": "west" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_closed", "y": 180 }
    },
    {
      "when": { "half": "lower", "open": "true", "facing": "north" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_open", "y": 270 }
    },
    {
      "when": { "half": "lower", "open": "true", "facing": "east" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_open", "y": 0 }
    },
    {
      "when": { "half": "lower", "open": "true", "facing": "south" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_open", "y": 90 }
    },
    {
      "when": { "half": "lower", "open": "true", "facing": "west" },
      "apply": { "model": "tzz_mod:block/catcher_chest_lower_open", "y": 180 }
    },
    {
      "when": { "half": "upper", "open": "false", "facing": "north" },
      "apply": { "model": "tzz_mod:block/catcher_chest_upper_closed", "y": 270 }
    },
    {
      "when": { "half": "upper", "open": "false", "facing": "east" },
      "apply": { "model": "tzz_mod:block/catcher_chest_upper_closed", "y": 0 }
