    {
      "when": { "half": "upper", "open": "true", "facing": "north" },
      "apply": { "model": "tzz_mod:block/catcher_chest_upper_open", "y": 270 }
    },
    {
      "when": { "half": "upper", "open": "true", "facing": "east" },
      "apply": { "model": "tzz_mod:block/catcher_chest_upper_open", "y": 0 }
    },
    {
      "when": { "half": "upper", "open": "true", "facing": "south" },
      "apply": { "model": "tzz_mod:block/catcher_chest_upper_open", "y": 90 }
    },
    {
      "when": { "half": "upper", "open": "true", "facing": "west" },
      "apply": { "model": "tzz_mod:block/catcher_chest_upper_open", "y": 180 }
